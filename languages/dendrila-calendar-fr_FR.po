msgid ""
msgstr ""
"Project-Id-Version: Dendrila Calendar 0.0.2\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Language: fr_FR\n"
"Plural-Forms: nplurals=2; plural=n>1;\n"

msgid "%1$d created, %2$d updated, %3$d cancelled, %4$d failed"
msgstr "%1$d créés, %2$d modifiés, %3$d annulés, %4$d échecs"

msgid "1. Choose your calendar service"
msgstr "1. Choisissez votre service d’agenda"

msgid "2. Connect your account"
msgstr "2. Connectez votre compte"

msgid "3. Choose where to add appointments"
msgstr "3. Choisissez où enregistrer les rendez-vous"

msgid "A compatibility request could not be submitted. Check your WordPress email delivery settings."
msgstr "Impossible de transmettre une demande de compatibilité. Vérifiez l’envoi des e-mails WordPress."

msgid "A connector compatibility request was submitted for review."
msgstr "Une demande de compatibilité de connecteur a été transmise pour examen."

msgid "A synchronization attempt has finished. Review its status below."
msgstr "Une tentative de synchronisation est terminée. Consultez son état ci-dessous."

msgid "A test event is created then removed before automatic synchronization begins."
msgstr "Un événement de test est créé puis supprimé avant le début de la synchronisation automatique."

msgid "Account authorization is not configured for this site."
msgstr "La connexion à ce compte n’est pas encore activée sur ce site."

msgid "Account authorization successful"
msgstr "Autorisation du compte réussie"

msgid "Account authorization was cancelled."
msgstr "L’autorisation du compte a été annulée."

msgid "Account authorized: choose your calendar"
msgstr "Compte autorisé : choisissez votre agenda"

msgid "Account username or email"
msgstr "Identifiant ou adresse e-mail"

msgid "Actual appointments read from detected booking plugins. Select an appointment in the calendar to open its original booking tool; imported bookings are not editable here."
msgstr "Rendez-vous réellement récupérés depuis les extensions détectées. Sélectionnez un rendez-vous dans le calendrier pour ouvrir son extension d’origine ; les réservations importées ne sont pas modifiables ici."

msgid "Add an event"
msgstr "Ajouter un événement"

msgid "Add calendar event"
msgstr "Ajouter un événement au calendrier"

msgid "All day"
msgstr "Toute la journée"

msgid "Another calendar service"
msgstr "Un autre service d’agenda"

msgid "Apple iCloud (app-specific password)"
msgstr "Apple iCloud (mot de passe d’application)"

msgid "Application credentials are managed in wp-config.php."
msgstr "Les identifiants de l’application sont gérés dans wp-config.php."

msgid "Application credentials saved. You can now authorize your account using the button below."
msgstr "Identifiants de l’application enregistrés. Vous pouvez maintenant autoriser votre compte avec le bouton ci-dessous."

msgid "Application password"
msgstr "Mot de passe d’application"

msgid "Appointment"
msgstr "Rendez-vous"

msgid "Appointments from all detected booking plugins appear here. External calendar connection is not required to view them."
msgstr "Les rendez-vous de toutes les extensions compatibles détectées s’affichent ici. Aucun agenda externe n’est nécessaire pour les consulter."

msgid "Appointments to send"
msgstr "Rendez-vous à transmettre"

msgid "Approved"
msgstr "Approuvé"

msgid "Automatic calendar synchronization"
msgstr "Synchronisation automatique des calendriers"

msgid "Automatic synchronization"
msgstr "Synchronisation automatique"

msgid "Back"
msgstr "Retour"

msgid "Back to calendar"
msgstr "Retour au calendrier"

msgid "Booking"
msgstr "Réservation"

msgid "Busy times are checked at booking submission. The Easy Appointments slot picker might still display those times."
msgstr "Les plages occupées sont vérifiées au moment d’envoyer la réservation. Le sélecteur Easy Appointments peut encore afficher ces horaires."

msgid "Calendar"
msgstr "Agenda"

msgid "Calendar availability is temporarily unavailable. Please try again."
msgstr "La vérification des disponibilités est temporairement indisponible. Réessayez."

msgid "Calendar connected. Automatic direct synchronization is enabled."
msgstr "Agenda connecté. La synchronisation directe est activée."

msgid "Calendar disconnected. Existing remote events were not removed."
msgstr "Agenda déconnecté. Les événements déjà transmis n’ont pas été supprimés."

msgid "Calendar disconnected. Previously created external events were not deleted."
msgstr "Agenda déconnecté. Les événements déjà créés à l’extérieur sont conservés."

msgid "Calendar discovery was redirected to another service."
msgstr "La connexion a été redirigée vers un autre service."

msgid "Calendar event"
msgstr "Événement du calendrier"

msgid "Calendar service"
msgstr "Service d’agenda"

msgid "Calendar view"
msgstr "Vue calendrier"

msgid "Cannot verify this appointment time. Please select another slot."
msgstr "Impossible de vérifier cet horaire de rendez-vous. Choisissez un autre créneau."

msgid "Change source and destination settings"
msgstr "Modifier les sources et la destination"

msgid "Check busy times in Google and Outlook before accepting an Easy Appointments booking."
msgstr "Vérifier les plages occupées dans Google et Outlook avant de confirmer une réservation Easy Appointments."

msgid "Check the calendar address, credentials and selected sources."
msgstr "Vérifiez l’adresse du calendrier, les identifiants et les sources sélectionnées."

msgid "Choose a calendar and at least one source."
msgstr "Choisissez un agenda et au moins une source."

msgid "Choose an agenda"
msgstr "Choisir un agenda"

msgid "Choose Google or Microsoft to authorize Dendrila Calendar, then select the calendar that will receive your appointments."
msgstr "Choisissez Google ou Microsoft pour autoriser Dendrila Calendar, puis sélectionnez l’agenda qui recevra vos rendez-vous."

msgid "Choose how appointments reach the calendar you already use."
msgstr "Choisissez comment les rendez-vous rejoindront votre agenda habituel."

msgid "Choose month"
msgstr "Choisir le mois"

msgid "Choose your destination calendar"
msgstr "Choisissez votre agenda de destination"

msgid "Choosing an app only changes the instructions. Create an actual private link below and add it in that app."
msgstr "Choisir une application ne change que les instructions. Créez un véritable lien privé ci-dessous et ajoutez-le dans cette application."

msgid "Compatible active plugins are preselected. You may deselect them. Inactive or unsupported plugins cannot be synchronized."
msgstr "Les extensions actives compatibles sont présélectionnées. Vous pouvez les décocher. Les extensions inactives ou non prises en charge ne peuvent pas être synchronisées."

msgid "Configuration"
msgstr "Configuration"

msgid "Configuration saved."
msgstr "Configuration enregistrée."

msgid "Configure application credentials (administrator)"
msgstr "Configurer les identifiants de l’application (administration)"

msgid "Configure Dendrila Calendar"
msgstr "Configurer Dendrila Calendar"

msgid "Configure sources and destination"
msgstr "Configurer les sources et la destination"

msgid "Connect a CalDAV calendar such as Nextcloud. New and changed WordPress bookings are pushed automatically approximately every five minutes while WordPress cron runs. This is one-way; the destination is never polled for changes."
msgstr "Connectez un agenda CalDAV, par exemple Nextcloud. Les nouveaux rendez-vous et leurs modifications sont envoyés environ toutes les cinq minutes lorsque les tâches programmées WordPress fonctionnent. La synchronisation est unidirectionnelle."

msgid "Connect at least one Google or Outlook calendar first."
msgstr "Connectez d’abord au moins un agenda Google ou Outlook."

msgid "Connect this calendar"
msgstr "Connecter cet agenda"

msgid "Connect with %s"
msgstr "Se connecter avec %s"

msgid "Connect your account"
msgstr "Connecter votre compte"

msgid "Connect your calendar account"
msgstr "Connecter votre compte d’agenda"

msgid "Connect your calendars, choose the bookings to send and protect your availability."
msgstr "Connectez vos agendas, choisissez les rendez-vous à envoyer et protégez vos disponibilités."

msgid "Connect your Google account securely. Authorization requires a configured Dendrila OAuth application."
msgstr "Connectez votre compte Google de manière sécurisée. L’application OAuth Dendrila doit être configurée."

msgid "Connect your Microsoft account securely. Authorization requires a configured Dendrila OAuth application."
msgstr "Connectez votre compte Microsoft de manière sécurisée. L’application OAuth Dendrila doit être configurée."

msgid "Connection method"
msgstr "Méthode de connexion"

msgid "Connection name"
msgstr "Nom de la connexion"

msgid "Continue"
msgstr "Continuer"

msgid "Continue to your provider’s secure account authorization. No calendar password is entered in WordPress."
msgstr "Poursuivez vers l’autorisation sécurisée de votre fournisseur. Aucun mot de passe d’agenda n’est saisi dans WordPress."

msgid "Copy link"
msgstr "Copier le lien"

msgid "Create a private read-only subscription link."
msgstr "Créez un lien d’abonnement privé en lecture seule."

msgid "Create subscription link"
msgstr "Créer un lien d’abonnement"

msgid "Date and time"
msgstr "Date et heure"

msgid "Date range is too large"
msgstr "La période demandée est trop longue"

msgid "Dendrila Calendar"
msgstr "Dendrila Calendar"

msgid "Dendrila Calendar setup"
msgstr "Configuration de Dendrila Calendar"

msgid "Dendrila events"
msgstr "Événements Dendrila"

msgid "Dendrila local events"
msgstr "Événements locaux Dendrila"

msgid "Direct account authorization is not available yet for this service. Dendrila cannot connect to your account just by selecting its name."
msgstr "La connexion directe à ce service n’est pas encore disponible. Sélectionner son nom ne suffit pas pour établir une connexion."

msgid "Direct authorization requires the publisher to configure the Dendrila OAuth application once. Users do not need developer credentials."
msgstr "La connexion directe doit être activée une fois par l’éditeur de Dendrila. Vous n’avez pas besoin de compte développeur."

msgid "Direct synchronization into an existing calendar"
msgstr "Synchronisation directe avec un agenda existant"

msgid "Disconnect"
msgstr "Déconnecter"

msgid "Edit calendar event"
msgstr "Modifier l’événement"

msgid "End"
msgstr "Fin"

msgid "Enter a valid client ID and secret. No credentials were changed."
msgstr "Saisissez un identifiant client et un secret valides. Aucun identifiant n’a été modifié."

msgid "Enter a valid HTTPS address for your calendar service."
msgstr "Saisissez une adresse HTTPS valide pour votre agenda."

msgid "Enter the web address of your Nextcloud, then your login details."
msgstr "Saisissez l’adresse de votre Nextcloud, puis vos identifiants."

msgid "Enter your calendar account and application password."
msgstr "Saisissez votre identifiant et votre mot de passe d’application."

msgid "Enter your calendar service address and account details."
msgstr "Saisissez l’adresse de votre service d’agenda, puis vos identifiants."

msgid "Enter your cloud address and choose an agenda."
msgstr "Saisissez l’adresse de votre cloud et choisissez un agenda."

msgid "Event"
msgstr "Événement"

msgid "Find events"
msgstr "Rechercher des événements"

msgid "Find my calendars"
msgstr "Trouver mes calendriers"

msgid "Find Subscribe by URL, Internet calendar, or iCalendar subscription in your calendar application. Paste the link rather than importing a one-time ICS file."
msgstr "Recherchez S’abonner par URL, Agenda Internet ou Abonnement iCalendar dans votre application. Collez le lien au lieu d’importer une seule fois un fichier ICS."

msgid "Finish by connecting your calendar account or creating an optional private calendar subscription."
msgstr "Terminez en connectant votre compte d’agenda ou en créant un abonnement privé facultatif."

msgid "Finish connecting an agenda below. Google and Outlook use account authorization; Nextcloud and iCloud use CalDAV."
msgstr "Terminez la connexion ci-dessous. Google et Outlook utilisent une autorisation de compte ; Nextcloud et iCloud utilisent CalDAV."

msgid "Finish connecting my calendar"
msgstr "Terminer la connexion de mon agenda"

msgid "Finish the Dendrila Calendar setup to enable your chosen appointment sources and destination."
msgstr "Terminez la configuration de Dendrila Calendar pour activer les sources et la destination souhaitées."

msgid "Forbidden"
msgstr "Accès refusé"

msgid "Google / Outlook"
msgstr "Google / Outlook"

msgid "Google and Outlook can authorize access when the Dendrila OAuth application is enabled by the publisher. Otherwise a read-only calendar subscription remains available."
msgstr "Google et Outlook peuvent autoriser l’accès lorsque l’application OAuth Dendrila est activée par son éditeur. Sinon, un abonnement en lecture seule reste disponible."

msgid "Google Calendar"
msgstr "Google Agenda"

msgid "Google Calendar and Outlook need OAuth account authorization and are not connected by this CalDAV form. Existing URL subscriptions remain available separately."
msgstr "Google Agenda et Outlook nécessitent une connexion OAuth, indisponible avec ce formulaire CalDAV. Les abonnements par URL restent disponibles séparément."

msgid "HTTPS is required for private calendar subscriptions."
msgstr "Le protocole HTTPS est obligatoire pour les abonnements privés."

msgid "iCalendar subscription"
msgstr "Abonnement iCalendar"

msgid "If a provider cannot be checked, the new reservation is refused rather than double-booked."
msgstr "Si un agenda ne peut pas être vérifié, la réservation est refusée pour éviter un doublon."

msgid "If an active booking plugin is detected but its connector is unusable, saving sends a technical compatibility request for review. This includes only the plugin name, entrypoint, version, reason, WordPress/PHP versions and site URL — never appointments, customer data or passwords. Duplicate requests are suppressed."
msgstr "Si une extension de réservation active est détectée mais que son connecteur est inutilisable, l’enregistrement transmettra une demande technique de compatibilité. Elle contiendra uniquement le nom de l’extension, son fichier principal, sa version, le motif, les versions WordPress/PHP et l’URL du site — jamais les rendez-vous, données clients ou mots de passe. Les demandes identiques sont regroupées."

msgid "In Nextcloud Calendar, choose New calendar > New subscription from link and paste the private URL. It will appear as a read-only subscribed calendar."
msgstr "Dans l’application Agenda de Nextcloud, choisissez Nouvel agenda > Nouvel abonnement depuis un lien, puis collez l’URL privée. Cet agenda sera accessible en lecture seule."

msgid "In Outlook on the web, open Calendar > Add calendar > Subscribe from web. Paste the link and save. Updates can take more than 24 hours."
msgstr "Dans Outlook sur le web : Calendrier > Ajouter un calendrier > S’abonner à partir du web. Collez le lien et enregistrez. Les mises à jour peuvent demander plus de 24 heures."

msgid "Invalid date range"
msgstr "Période invalide"

msgid "Keep my appointments inside WordPress only"
msgstr "Garder mes rendez-vous uniquement dans WordPress"

msgid "Last synchronization:"
msgstr "Dernière synchronisation :"

msgid "Link copied."
msgstr "Lien copié."

msgid "List"
msgstr "Liste"

msgid "Loading events…"
msgstr "Chargement des événements…"

msgid "Local events"
msgstr "Événements locaux"

msgid "Local events can be sent to connected external calendars. They do not yet block booking availability in third-party booking plugins. Do not use this form to prevent reservations."
msgstr "Les événements locaux peuvent être envoyés aux agendas externes connectés. Ils ne bloquent pas encore les disponibilités dans les extensions de réservation. Ne les utilisez pas pour empêcher une réservation."

msgid "Looking for your calendars…"
msgstr "Recherche de vos agendas…"

msgid "Manage local events"
msgstr "Gérer les événements locaux"

msgid "Maximum number of subscriptions reached. Revoke an old link first."
msgstr "Nombre maximal d’abonnements atteint. Révoquez d’abord un ancien lien."

msgid "Month"
msgstr "Mois"

msgid "My calendar"
msgstr "Mon calendrier"

msgid "Never synchronized"
msgstr "Jamais synchronisé"

msgid "Next"
msgstr "Suivant"

msgid "Nextcloud (direct connection)"
msgstr "Nextcloud (connexion directe)"

msgid "Nextcloud / iCloud"
msgstr "Nextcloud / iCloud"

msgid "No calendar was found in this account."
msgstr "Aucun calendrier trouvé dans ce compte."

msgid "No events for this period."
msgstr "Aucun événement pour cette période."

msgid "No events returned by the active source connectors for the next 60 days. Check the source diagnostics below."
msgstr "Aucun événement renvoyé par les connecteurs actifs dans les 60 prochains jours. Consultez le diagnostic des sources ci-dessous."

msgid "No external destination connected yet. Complete the connection on the Synchronization page."
msgstr "Aucune destination externe n’est encore connectée. Terminez la connexion depuis la page Synchronisation."

msgid "No supported appointment plugin was detected. You can start with local events and return to setup later."
msgstr "Aucune extension de réservation compatible n’a été détectée. Vous pouvez commencer avec les événements locaux et revenir ensuite dans l’assistant."

msgid "No writable calendar was found in this account."
msgstr "Aucun agenda modifiable n’a été trouvé sur ce compte."

msgid "Not authorized."
msgstr "Accès refusé."

msgid "OAuth client ID"
msgstr "Identifiant client OAuth"

msgid "OAuth client secret"
msgstr "Secret client OAuth"

msgid "On a computer, open Google Calendar settings, choose Add calendar > From URL, paste the private HTTPS link, and add the calendar. Google decides when to refresh it. The mobile app cannot add URL subscriptions directly."
msgstr "Depuis un ordinateur, ouvrez les paramètres de Google Agenda, puis Ajouter un agenda > À partir de l’URL. Collez le lien HTTPS privé. Google choisit la fréquence d’actualisation ; l’application mobile ne permet pas d’ajouter directement un abonnement par URL."

msgid "On iPhone: Calendar > Calendars > Add Calendar > Add Subscription Calendar. Paste the URL. On Mac: File > New Calendar Subscription. You can also try Open Apple Calendar subscription after creating a link."
msgstr "Sur iPhone : Calendrier > Calendriers > Ajouter un calendrier > Ajouter un calendrier avec abonnement, puis collez l’URL. Sur Mac : Fichier > Nouvel abonnement à un calendrier. Vous pouvez également essayer le bouton Ouvrir l’abonnement dans Calendrier Apple."

msgid "Open Apple Calendar subscription"
msgstr "Ouvrir l’abonnement dans Calendrier Apple"

msgid "Open calendar view"
msgstr "Ouvrir la vue calendrier"

msgid "Open configuration assistant"
msgstr "Ouvrir l’assistant de configuration"

msgid "Open unified calendar"
msgstr "Ouvrir le calendrier unifié"

msgid "Other CalDAV service"
msgstr "Autre service CalDAV"

msgid "Outlook / Microsoft 365"
msgstr "Outlook / Microsoft 365"

msgid "Paste your client ID"
msgstr "Collez votre identifiant client"

msgid "Paste your secret (never displayed again)"
msgstr "Collez votre secret (il ne sera plus affiché)"

msgid "Pending"
msgstr "En attente"

msgid "Pick your everyday calendar. We will guide you without technical setup."
msgstr "Choisissez votre agenda habituel. Nous vous guiderons sans réglages techniques."

msgid "Prevent double bookings"
msgstr "Empêcher les doubles réservations"

msgid "Previous"
msgstr "Précédent"

msgid "Protect Easy Appointments reservations"
msgstr "Protéger les réservations Easy Appointments"

msgid "Ready to connect"
msgstr "Prêt à connecter"

msgid "Redirect URI:"
msgstr "URI de redirection :"

msgid "Reserved day"
msgstr "Journée réservée"

msgid "Revoke link"
msgstr "Révoquer le lien"

msgid "Revoke this subscription? Connected calendars will stop updating."
msgstr "Révoquer cet abonnement ? Les calendriers connectés cesseront de recevoir ses mises à jour."

msgid "Save application credentials"
msgstr "Enregistrer les identifiants de l’application"

msgid "Save availability protection"
msgstr "Enregistrer la protection des disponibilités"

msgid "Save settings and continue"
msgstr "Enregistrer et continuer"

msgid "Saved securely in the WordPress database, encrypted with this site’s keys. Leave a field empty to keep its saved value. Never paste credentials into chat."
msgstr "Enregistrés dans la base WordPress et chiffrés avec les clés du site. Laissez un champ vide pour conserver sa valeur. Ne partagez jamais ces identifiants dans une discussion."

msgid "Search title or status"
msgstr "Rechercher par titre ou statut"

msgid "Select all"
msgstr "Tout sélectionner"

msgid "Select and copy the link manually."
msgstr "Sélectionnez et copiez le lien manuellement."

msgid "Select at least one appointment source."
msgstr "Sélectionnez au moins une source de rendez-vous."

msgid "Select at least one available source and a valid destination."
msgstr "Choisissez au moins une source disponible et une destination valide."

msgid "Select at least one calendar source."
msgstr "Sélectionnez au moins une source de calendrier."

msgid "Select none"
msgstr "Tout désélectionner"

msgid "Select your WordPress sources, create a private calendar URL, then subscribe to it in your calendar app. The app refreshes events automatically on its own schedule; this is a read-only subscription, not instant or two-way synchronization."
msgstr "Sélectionnez les sources WordPress, créez une adresse privée puis abonnez-y votre agenda. Les événements s’actualisent automatiquement selon la fréquence choisie par votre application. Cette synchronisation est en lecture seule, non instantanée et non bidirectionnelle."

msgid "Setup required"
msgstr "Configuration nécessaire"

msgid "Show instructions for this application (not a connection)"
msgstr "Afficher les instructions pour cette application (sans connexion)"

msgid "Source"
msgstr "Source"

msgid "Sources"
msgstr "Sources"

msgid "Sources to synchronize"
msgstr "Sources à synchroniser"

msgid "Start"
msgstr "Début"

msgid "Status"
msgstr "Statut"

msgid "Step 1 — Detected appointment sources"
msgstr "Étape 1 — Sources de rendez-vous détectées"

msgid "Step 2 — Your destination calendar"
msgstr "Étape 2 — Votre agenda de destination"

msgid "Subscribe your personal calendar"
msgstr "Synchroniser votre agenda personnel"

msgid "Subscription created. Copy the URL now; it will not be shown again."
msgstr "Abonnement créé. Copiez l’URL maintenant : elle ne sera plus affichée."

msgid "Subscription name (e.g. personal calendar)"
msgstr "Nom de l’abonnement (ex. calendrier personnel)"

msgid "Subscription not found."
msgstr "Abonnement introuvable."

msgid "Subscription revoked."
msgstr "Abonnement révoqué."

msgid "Synchronization"
msgstr "Synchronisation"

msgid "Synchronization attempt finished. Review the status below."
msgstr "Tentative de synchronisation terminée. Consultez le bilan ci-dessous."

msgid "Synchronize appointments with your external calendar"
msgstr "Synchroniser les rendez-vous avec votre agenda externe"

msgid "Synchronize now"
msgstr "Synchroniser maintenant"

msgid "Test and connect this calendar"
msgstr "Tester et connecter cet agenda"

msgid "The calendar connection could not be saved. Please try again."
msgstr "Impossible d’enregistrer la connexion à cet agenda. Réessayez."

msgid "The calendar server redirected to an unsafe address."
msgstr "La connexion a été redirigée vers une adresse non autorisée."

msgid "The calendar service could not be reached securely."
msgstr "La connexion sécurisée au service de calendrier a échoué."

msgid "The calendar service did not accept the connection ("
msgstr "Le service d’agenda a refusé la connexion ("

msgid "The calendar service returned an unreadable response. PHP DOM/XML may be unavailable."
msgstr "Réponse illisible du service. Le module XML de PHP peut être manquant."

msgid "The calendar write test failed. Check the application password and make sure you can add and delete events in this calendar."
msgstr "Le test d’écriture a échoué. Vérifiez le mot de passe d’application et vos droits d’ajout et de suppression dans cet agenda."

msgid "The connection could not be completed. Try again."
msgstr "La connexion n’a pas pu aboutir. Réessayez."

msgid "The connection expired. Try again."
msgstr "La connexion a expiré. Réessayez."

msgid "The full link is displayed only once after creation. If it is lost, revoke it and create a new one."
msgstr "Le lien complet ne s’affiche qu’une fois après sa création. S’il est perdu, révoquez-le et créez-en un autre."

msgid "The provider did not confirm that events can be created and removed. No connection was saved."
msgstr "Le service n’a pas confirmé les droits de création et de suppression d’événements. Aucune connexion n’a été enregistrée."

msgid "The provider has granted access. Select the destination calendar and confirm the final test."
msgstr "Le service a autorisé l’accès. Choisissez l’agenda de destination, puis confirmez le test final."

msgid "The server cannot securely protect the calendar password."
msgstr "Le serveur ne peut pas protéger de manière sûre le mot de passe du calendrier."

msgid "The subscription could not be saved. Try again."
msgstr "L’abonnement n’a pas pu être enregistré. Réessayez."

msgid "This account did not expose a calendar collection."
msgstr "Aucun calendrier accessible trouvé pour ce compte."

msgid "This assistant detects active appointment plugins and guides external synchronization. You can view the local calendar before connecting an external destination."
msgstr "Cet assistant détecte les extensions de réservation actives et vous guide pour synchroniser un agenda externe. Vous pouvez consulter le calendrier local avant de connecter une destination."

msgid "This list contains only events created in Dendrila Calendar. Appointments imported from Easy Appointments and other plugins appear in the unified calendar."
msgstr "Cette liste contient uniquement les événements créés dans Dendrila Calendar. Les rendez-vous importés depuis Easy Appointments et les autres extensions apparaissent dans le calendrier unifié."

msgid "This server did not provide a calendar account. Check your service address."
msgstr "Le service n’a pas fourni de compte de calendrier. Vérifiez son adresse."

msgid "This time is occupied in a connected calendar. Please choose another."
msgstr "Ce créneau est déjà occupé dans un agenda connecté. Choisissez-en un autre."

msgid "Times use the site timezone: %s. The event is visible only to administrators."
msgstr "Les horaires utilisent le fuseau horaire du site : %s. L’événement est visible uniquement par les administrateurs."

msgid "Today"
msgstr "Aujourd’hui"

msgid "Too many calendar redirects."
msgstr "Trop de redirections pendant la connexion."

msgid "Too many connected calendars."
msgstr "Nombre maximal d’agendas connectés atteint."

msgid "Too many connection attempts. Please try again later."
msgstr "Trop de tentatives de connexion. Réessayez plus tard."

msgid "Treat the link as a password. Anyone holding it can read the selected event titles and dates. Only HTTPS sites can create links."
msgstr "Traitez ce lien comme un mot de passe. Toute personne qui le possède peut consulter les titres et dates des événements sélectionnés. Un site HTTPS est nécessaire pour créer des liens."

msgid "Unable to find calendars. Check your account details and try again."
msgstr "Impossible de trouver les agendas. Vérifiez votre compte puis réessayez."

msgid "Unable to generate a private link."
msgstr "Impossible de générer un lien privé."

msgid "Unable to load events. Please try again."
msgstr "Impossible de charger les événements. Réessayez."

msgid "Unable to prepare calendar selection."
msgstr "Impossible de préparer le choix du calendrier."

msgid "Unable to update the subscription."
msgstr "Impossible de mettre à jour l’abonnement."

msgid "Unified calendar"
msgstr "Calendrier unifié"

msgid "Unsupported calendar service."
msgstr "Service d’agenda non pris en charge."

msgid "Upcoming appointments (server view)"
msgstr "Rendez-vous à venir (vue serveur)"

msgid "Use a read-only calendar subscription instead"
msgstr "Utiliser plutôt un abonnement de calendrier en lecture seule"

msgid "Use an Apple app password to connect your iCloud calendar."
msgstr "Utilisez un mot de passe d’application Apple pour connecter votre agenda iCloud."

msgid "Use an application-specific password if your service requires one. Your password is encrypted before it is saved."
msgstr "Utilisez un mot de passe spécifique à l’application si le service le demande. Votre mot de passe sera chiffré avant son enregistrement."

msgid "Use your Apple Account email and an app-specific password. Connection may not work on every iCloud account yet."
msgstr "Utilisez votre adresse de compte Apple et un mot de passe spécifique à l’application. La connexion n’est pas encore validée sur tous les comptes iCloud."

msgid "View"
msgstr "Vue"

msgid "We will add and remove a temporary event to test the connection."
msgstr "Un événement temporaire sera ajouté puis supprimé pour vérifier la connexion."

msgid "We will guide you through the connection. You do not need an API key or a technical calendar address."
msgstr "La connexion est guidée. Aucune clé API ni adresse technique de calendrier n’est nécessaire."

msgid "Week"
msgstr "Semaine"

msgid "Where should your appointments appear?"
msgstr "Où souhaitez-vous voir vos rendez-vous ?"

msgid "Where will you use your calendar?"
msgstr "Dans quel agenda souhaitez-vous afficher vos événements ?"

msgid "Which appointments should be sent?"
msgstr "Quels rendez-vous envoyer ?"

msgid "Which calendar do you use?"
msgstr "Quel agenda utilisez-vous ?"

msgid "You are not allowed to configure Dendrila Calendar."
msgstr "Vous ne pouvez pas configurer Dendrila Calendar."

msgid "You are not allowed to manage calendar connections."
msgstr "Vous ne pouvez pas gérer les connexions des agendas."

msgid "You are not allowed to view this calendar."
msgstr "Vous n’avez pas le droit de consulter ce calendrier."

msgid "You cannot manage calendar connections."
msgstr "Vous ne pouvez pas gérer les connexions des agendas."

msgid "You cannot manage calendar subscriptions."
msgstr "Vous ne pouvez pas gérer les abonnements du calendrier."

msgid "Your calendar has been connected and synchronization started."
msgstr "Votre agenda est connecté et la synchronisation a démarré."

msgid "Your cloud address"
msgstr "Adresse de votre cloud"
