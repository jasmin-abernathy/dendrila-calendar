msgid ""
msgstr ""
"Project-Id-Version: Dendrila Calendar 0.0.4\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Language: fr_FR\n"
"Plural-Forms: nplurals=2; plural=n>1;\n"

msgid "%1$d created, %2$d updated, %3$d cancelled, %4$d failed"
msgstr "%1$d créés, %2$d modifiés, %3$d annulés, %4$d échecs"

msgid "%s minutes"
msgstr "%s minutes"

msgid "1. Choose your calendar service"
msgstr "1. Choisissez votre service d’agenda"

msgid "2. Connect your account"
msgstr "2. Connectez votre compte"

msgid "3. Choose where to add appointments"
msgstr "3. Choisissez où enregistrer les rendez-vous"

msgid "A compatibility request could not be submitted. Check your WordPress email delivery settings."
msgstr "Impossible de transmettre une demande de compatibilité. Vérifiez l’envoi des e-mails WordPress."

msgid "A connector compatibility request was submitted for review."
msgstr "Une demande de compatibilité de connecteur a été transmise pour examen."

msgid "A date exception replaces the weekly hours for that date. Close the whole day or enter different time ranges."
msgstr "Une exception remplace les horaires hebdomadaires de la date choisie. Fermez toute la journée ou indiquez des horaires particuliers."

msgid "A horizon of 0 days removes the rolling limit. Any fixed date limits still apply."
msgstr "0 jour supprime la limite du nombre de jours à l’avance. Les éventuelles dates limites restent applicables."

msgid "A profile is required before a service can be offered for booking."
msgstr "Un profil est nécessaire avant qu’une prestation puisse être réservable."

msgid "A synchronization attempt has finished. Review its status below."
msgstr "Une tentative de synchronisation est terminée. Consultez son état ci-dessous."

msgid "A test event is created then removed before automatic synchronization begins."
msgstr "Un événement de test est créé puis supprimé avant le début de la synchronisation automatique."

msgid "Account authorization is not configured for this site."
msgstr "La connexion à ce compte n’est pas encore activée sur ce site."

msgid "Account authorization successful"
msgstr "Autorisation du compte réussie"

msgid "Account authorization was cancelled."
msgstr "L’autorisation du compte a été annulée."

msgid "Account authorized: choose your calendar"
msgstr "Compte autorisé : choisissez votre agenda"

msgid "Account username or email"
msgstr "Identifiant ou adresse e-mail"

msgid "Actual appointments read from detected booking plugins. Select an appointment in the calendar to open its original booking tool; imported bookings are not editable here."
msgstr "Rendez-vous réellement récupérés depuis les extensions détectées. Sélectionnez un rendez-vous dans le calendrier pour ouvrir son extension d’origine ; les réservations importées ne sont pas modifiables ici."

msgid "Add a WooCommerce appointment product"
msgstr "Ajouter un produit de rendez-vous WooCommerce"

msgid "Add a date exception"
msgstr "Ajouter une exception par date"

msgid "Add a profile"
msgstr "Ajouter un profil"

msgid "Add a service"
msgstr "Ajouter une prestation"

msgid "Add a time range"
msgstr "Ajouter une plage horaire"

msgid "Add an event"
msgstr "Ajouter un événement"

msgid "Add booking profile"
msgstr "Ajouter un profil de réservation"

msgid "Add booking to a page"
msgstr "Ajouter la réservation à une page"

msgid "Add calendar event"
msgstr "Ajouter un événement au calendrier"

msgid "Add separate time ranges for a lunch break. 00:00 as an end time means midnight at the end of the day."
msgstr "Prévoyez des plages séparées pour une pause déjeuner. 00:00 en fin de plage signifie minuit en fin de journée."

msgid "Add service"
msgstr "Ajouter une prestation"

msgid "Add to my calendar (.ics)"
msgstr "Ajouter à mon agenda (.ics)"

msgid "All day"
msgstr "Toute la journée"

msgid "All-day event"
msgstr "Événement sur la journée entière"

msgid "An exception contains an invalid date."
msgstr "Une exception contient une date non valide."

msgid "Another calendar service"
msgstr "Un autre service d’agenda"

msgid "Another reservation is being processed. Please try again in a moment."
msgstr "Une autre réservation est en cours de traitement. Réessayez dans un instant."

msgid "Apple iCloud (app-specific password)"
msgstr "Apple iCloud (mot de passe d’application)"

msgid "Application credentials are managed in wp-config.php."
msgstr "Les identifiants de l’application sont gérés dans wp-config.php."

msgid "Application credentials saved. You can now authorize your account using the button below."
msgstr "Identifiants de l’application enregistrés. Vous pouvez maintenant autoriser votre compte avec le bouton ci-dessous."

msgid "Application password"
msgstr "Mot de passe d’application"

msgid "Appointment"
msgstr "Rendez-vous"

msgid "Appointment booking"
msgstr "Réservation de rendez-vous"

msgid "Appointments from all detected booking plugins appear here. External calendar connection is not required to view them."
msgstr "Les rendez-vous de toutes les extensions compatibles détectées s’affichent ici. Aucun agenda externe n’est nécessaire pour les consulter."

msgid "Appointments to send"
msgstr "Rendez-vous à transmettre"

msgid "Approved"
msgstr "Approuvé"

msgid "At least one active profile is ready."
msgstr "Au moins un profil actif est prêt."

msgid "Automatic calendar synchronization"
msgstr "Synchronisation automatique des calendriers"

msgid "Automatic synchronization"
msgstr "Synchronisation automatique"

msgid "Availability"
msgstr "Disponibilités"

msgid "Availability closed"
msgstr "Disponibilités fermées"

msgid "Availability enabled"
msgstr "Disponibilités activées"

msgid "Availability is temporarily unavailable. Please contact the organizer."
msgstr "Les disponibilités ne peuvent pas être vérifiées pour le moment. Contactez l’organisateur."

msgid "Availability settings were not saved. Previous settings were kept."
msgstr "Les disponibilités n’ont pas été enregistrées. Les réglages précédents ont été conservés."

msgid "Available times"
msgstr "Horaires disponibles"

msgid "Available times could not be checked. Please try another date or reload this page."
msgstr "Les horaires disponibles n’ont pas pu être vérifiés. Essayez une autre date ou rechargez cette page."

msgid "Back"
msgstr "Retour"

msgid "Back to calendar"
msgstr "Retour au calendrier"

msgid "Book up to this many days ahead"
msgstr "Nombre maximal de jours à l’avance"

msgid "Booking"
msgstr "Réservation"

msgid "Booking details"
msgstr "Détails de la réservation"

msgid "Booking limits must be whole numbers from 0 to 10000."
msgstr "Les limites de réservation doivent être des nombres entiers compris entre 0 et 10 000."

msgid "Booking profile"
msgstr "Profil de réservation"

msgid "Booking profiles"
msgstr "Profils de réservation"

msgid "Booking reference"
msgstr "Référence de réservation"

msgid "Booking rules"
msgstr "Règles de réservation"

msgid "Booking: %s"
msgstr "Réservation : %s"

msgid "Bookings"
msgstr "Réservations"

msgid "Bookings per day"
msgstr "Réservations par jour"

msgid "Bookings per month"
msgstr "Réservations par mois"

msgid "Bookings per week"
msgstr "Réservations par semaine"

msgid "Both copies changed. Match their titles and dates in both calendars, then synchronize again. Local event IDs:"
msgstr "Les deux copies ont été modifiées. Donnez-leur les mêmes titres et dates dans les deux agendas, puis relancez la synchronisation. Identifiants des événements locaux :"

msgid "Busy times also disable public Easy Appointments slots. Final booking submission is rechecked directly with connected calendars."
msgstr "Les créneaux occupés sont aussi désactivés dans le formulaire public Easy Appointments. La disponibilité est de nouveau vérifiée à la validation de la réservation."

msgid "Calendar"
msgstr "Agenda"

msgid "Calendar actions"
msgstr "Actions du calendrier"

msgid "Calendar availability is temporarily unavailable. Please try again."
msgstr "La vérification des disponibilités est temporairement indisponible. Réessayez."

msgid "Calendar connected. Automatic direct synchronization is enabled."
msgstr "Agenda connecté. La synchronisation directe est activée."

msgid "Calendar disconnected. Existing remote events were not removed."
msgstr "Agenda déconnecté. Les événements déjà transmis n’ont pas été supprimés."

msgid "Calendar disconnected. Previously created external events were not deleted."
msgstr "Agenda déconnecté. Les événements déjà créés à l’extérieur sont conservés."

msgid "Calendar discovery was redirected to another service."
msgstr "La connexion a été redirigée vers un autre service."

msgid "Calendar event"
msgstr "Événement du calendrier"

msgid "Calendar reading was interrupted. Retry synchronization."
msgstr "La lecture de l’agenda a été interrompue. Relancez la synchronisation."

msgid "Calendar service"
msgstr "Service d’agenda"

msgid "Calendar view"
msgstr "Vue calendrier"

msgid "Cancel this booking"
msgstr "Annuler cette réservation"

msgid "Cancel this booking and release the time?"
msgstr "Annuler cette réservation et libérer le créneau ?"

msgid "Cancel this reservation"
msgstr "Annuler cette réservation"

msgid "Cancelling releases the time. Paid orders are not automatically refunded; manage any refund in WooCommerce."
msgstr "L’annulation libère le créneau. Les commandes payées ne sont pas remboursées automatiquement ; gérez tout remboursement dans WooCommerce."

msgid "Cancelling your booking…"
msgstr "Annulation de votre réservation…"

msgid "Cannot verify this appointment time. Please select another slot."
msgstr "Impossible de vérifier cet horaire de rendez-vous. Choisissez un autre créneau."

msgid "Change source and destination settings"
msgstr "Modifier les sources et la destination"

msgid "Check busy times in Google and Outlook before accepting an Easy Appointments booking."
msgstr "Vérifier les plages occupées dans Google et Outlook avant de confirmer une réservation Easy Appointments."

msgid "Check busy times in all connected Google and Outlook calendars"
msgstr "Vérifier les périodes occupées dans tous les agendas Google et Outlook connectés"

msgid "Check the appointment fields. Previous booking settings were kept."
msgstr "Vérifiez les champs du rendez-vous. Les réglages de réservation précédents ont été conservés."

msgid "Check the availability fields and try again."
msgstr "Vérifiez les champs de disponibilité, puis réessayez."

msgid "Check the calendar address, credentials and selected sources."
msgstr "Vérifiez l’adresse du calendrier, les identifiants et les sources sélectionnées."

msgid "Check the notice, date range, interval and booking limits."
msgstr "Vérifiez le délai minimal, la période, l’intervalle entre les horaires et les limites de réservation."

msgid "Check your booking details."
msgstr "Vérifiez les informations de votre réservation."

msgid "Checking available times…"
msgstr "Vérification des horaires disponibles…"

msgid "Choose Google or Microsoft to authorize Dendrila Calendar, then select the calendar that will receive your appointments."
msgstr "Choisissez Google ou Microsoft pour autoriser Dendrila Calendar, puis sélectionnez l’agenda qui recevra vos rendez-vous."

msgid "Choose a calendar and at least one source."
msgstr "Choisissez un agenda et au moins une source."

msgid "Choose a date within the available booking period."
msgstr "Choisissez une date dans la période de réservation proposée."

msgid "Choose a later time to leave enough time for payment."
msgstr "Choisissez un horaire plus tardif pour disposer du temps nécessaire au paiement."

msgid "Choose a responsible profile in the service settings."
msgstr "Choisissez un profil responsable dans les réglages de la prestation."

msgid "Choose a service"
msgstr "Choisissez une prestation"

msgid "Choose a service and an available time, then enter your details."
msgstr "Choisissez une prestation et un horaire disponible, puis indiquez vos coordonnées."

msgid "Choose a service to see available times."
msgstr "Choisissez une prestation pour consulter les horaires disponibles."

msgid "Choose a simple product and a published responsible profile before enabling appointment booking."
msgstr "Choisissez un produit simple et un profil responsable publié avant d’activer la réservation de rendez-vous."

msgid "Choose a simple, virtual product that can be purchased now. Its WooCommerce price is used for payment."
msgstr "Choisissez un produit simple, virtuel et disponible à l’achat. Son prix WooCommerce sera utilisé pour le paiement."

msgid "Choose a time that works for you"
msgstr "Choisissez l’horaire qui vous convient"

msgid "Choose an agenda"
msgstr "Choisir un agenda"

msgid "Choose an appointment time"
msgstr "Choisir un horaire de rendez-vous"

msgid "Choose an available appointment time on the product page before paying for this service."
msgstr "Choisissez un horaire de rendez-vous disponible sur la page du produit avant de payer cette prestation."

msgid "Choose an available time below."
msgstr "Choisissez un horaire disponible ci-dessous."

msgid "Choose how appointments reach the calendar you already use."
msgstr "Choisissez comment les rendez-vous rejoindront votre agenda habituel."

msgid "Choose month"
msgstr "Choisir le mois"

msgid "Choose your destination calendar"
msgstr "Choisissez votre agenda de destination"

msgid "Choosing an app only changes the instructions. Create an actual private link below and add it in that app."
msgstr "Choisir une application ne change que les instructions. Créez un véritable lien privé ci-dessous et ajoutez-le dans cette application."

msgid "Closed"
msgstr "Fermé"

msgid "Closed all day"
msgstr "Fermé toute la journée"

msgid "Compatible active plugins are preselected. You may deselect them. Inactive or unsupported plugins cannot be synchronized."
msgstr "Les extensions actives compatibles sont présélectionnées. Vous pouvez les décocher. Les extensions inactives ou non prises en charge ne peuvent pas être synchronisées."

msgid "Complete payment before %s. After that, the time can become available again."
msgstr "Terminez le paiement avant %s. Passé ce délai, le créneau pourra redevenir disponible."

msgid "Complete the payment to confirm your appointment."
msgstr "Terminez le paiement pour confirmer votre rendez-vous."

msgid "Configuration"
msgstr "Configuration"

msgid "Configuration saved."
msgstr "Configuration enregistrée."

msgid "Configure Dendrila Calendar"
msgstr "Configurer Dendrila Calendar"

msgid "Configure application credentials (administrator)"
msgstr "Configurer les identifiants de l’application (administration)"

msgid "Configure sources and destination"
msgstr "Configurer les sources et la destination"

msgid "Confirm booking"
msgstr "Confirmer la réservation"

msgid "Connect a CalDAV calendar such as Nextcloud. New and changed WordPress bookings are pushed automatically approximately every five minutes while WordPress cron runs. This is one-way; the destination is never polled for changes."
msgstr "Connectez un agenda CalDAV, par exemple Nextcloud. Les nouveaux rendez-vous et leurs modifications sont envoyés environ toutes les cinq minutes lorsque les tâches programmées WordPress fonctionnent. La synchronisation est unidirectionnelle."

msgid "Connect and synchronize this calendar"
msgstr "Connecter et synchroniser cet agenda"

msgid "Connect at least one Google or Outlook calendar first."
msgstr "Connectez d’abord au moins un agenda Google ou Outlook."

msgid "Connect this calendar"
msgstr "Connecter cet agenda"

msgid "Connect with %s"
msgstr "Se connecter avec %s"

msgid "Connect your Google account securely. Authorization requires a configured Dendrila OAuth application."
msgstr "Connectez votre compte Google de manière sécurisée. L’application OAuth Dendrila doit être configurée."

msgid "Connect your Microsoft account securely. Authorization requires a configured Dendrila OAuth application."
msgstr "Connectez votre compte Microsoft de manière sécurisée. L’application OAuth Dendrila doit être configurée."

msgid "Connect your account"
msgstr "Connecter votre compte"

msgid "Connect your calendar account"
msgstr "Connecter votre compte d’agenda"

msgid "Connect your calendars, choose the bookings to send and protect your availability."
msgstr "Connectez vos agendas, choisissez les rendez-vous à envoyer et protégez vos disponibilités."

msgid "Connected calendars"
msgstr "Agendas connectés"

msgid "Connection method"
msgstr "Méthode de connexion"

msgid "Connection name"
msgstr "Nom de la connexion"

msgid "Connections grouped. No calendar events were deleted."
msgstr "Connexions regroupées. Aucun événement de l’agenda n’a été supprimé."

msgid "Contact the organizer to cancel a paid booking and discuss any refund."
msgstr "Contactez l’organisateur pour annuler une réservation payante et convenir d’un éventuel remboursement."

msgid "Continue"
msgstr "Continuer"

msgid "Continue to payment"
msgstr "Passer au paiement"

msgid "Continue to your provider’s secure account authorization. No calendar password is entered in WordPress."
msgstr "Poursuivez vers l’autorisation sécurisée de votre fournisseur. Aucun mot de passe d’agenda n’est saisi dans WordPress."

msgid "Copy link"
msgstr "Copier le lien"

msgid "Copy titles and dates between this calendar and WordPress. Deletions propagate. New single events are found from 7 days ago to 85 days ahead. Recurring events and invitations are skipped. Other booking sources are export only."
msgstr "Les titres et les dates sont synchronisés entre cet agenda et WordPress, ainsi que les suppressions. Les nouveaux événements ponctuels sont recherchés de 7 jours dans le passé à 85 jours dans le futur. Les événements récurrents et les invitations sont ignorés. Les réservations des autres extensions sont uniquement exportées."

msgid "Create a WooCommerce product for a paid appointment and use its Appointment booking tab. You can also create a free service directly here. Every service needs a responsible profile."
msgstr "Pour un rendez-vous payant, créez un produit WooCommerce et utilisez son onglet « Réservation de rendez-vous ». Vous pouvez aussi créer une prestation gratuite directement ici. Chaque prestation nécessite un profil responsable."

msgid "Create a private read-only subscription link."
msgstr "Créez un lien d’abonnement privé en lecture seule."

msgid "Create a profile"
msgstr "Créer un profil"

msgid "Create a profile and assign it to a published service before accepting bookings."
msgstr "Créez un profil et associez-le à une prestation publiée avant d’accepter des réservations."

msgid "Create and publish at least one booking profile before offering a service."
msgstr "Créez et publiez au moins un profil avant de proposer une prestation."

msgid "Create subscription link"
msgstr "Créer un lien d’abonnement"

msgid "Create the first profile"
msgstr "Créer le premier profil"

msgid "Customer"
msgstr "Client"

msgid "Date"
msgstr "Date"

msgid "Date and time"
msgstr "Date et heure"

msgid "Date exception %d"
msgstr "Exception de date %d"

msgid "Date exception added. Choose a date."
msgstr "Exception ajoutée. Choisissez une date."

msgid "Date exception removed."
msgstr "Exception de date supprimée."

msgid "Date exceptions"
msgstr "Exceptions par date"

msgid "Date range is too large"
msgstr "La période demandée est trop longue"

msgid "Dendrila Calendar"
msgstr "Dendrila Calendar"

msgid "Dendrila Calendar setup"
msgstr "Configuration de Dendrila Calendar"

msgid "Dendrila bookings"
msgstr "Réservations Dendrila"

msgid "Dendrila could not prepare this booking payment."
msgstr "Dendrila n’a pas pu préparer le paiement de cette réservation."

msgid "Dendrila events"
msgstr "Événements Dendrila"

msgid "Dendrila local events"
msgstr "Événements locaux Dendrila"

msgid "Dendrila: this payment arrived after the booking was released or cancelled. The appointment is NOT confirmed. Contact the customer to arrange another time or a refund."
msgstr "Dendrila : ce paiement est arrivé après la libération ou l’annulation de la réservation. Le rendez-vous N’EST PAS confirmé. Contactez la personne pour convenir d’un autre horaire ou d’un remboursement."

msgid "Direct account authorization is not available yet for this service. Dendrila cannot connect to your account just by selecting its name."
msgstr "La connexion directe à ce service n’est pas encore disponible. Sélectionner son nom ne suffit pas pour établir une connexion."

msgid "Direct authorization requires the publisher to configure the Dendrila OAuth application once. Users do not need developer credentials."
msgstr "La connexion directe doit être activée une fois par l’éditeur de Dendrila. Vous n’avez pas besoin de compte développeur."

msgid "Direct synchronization into an existing calendar"
msgstr "Synchronisation directe avec un agenda existant"

msgid "Disconnect"
msgstr "Déconnecter"

msgid "Duration in minutes"
msgstr "Durée en minutes"

msgid "Duration, preparation time and recovery time are set in the other service settings. The appointment must fit within the profile hours; its preparation and recovery time must also be free."
msgstr "La durée et les temps de préparation et de récupération se règlent dans les autres paramètres de la prestation. Le rendez-vous doit tenir dans les horaires du profil ; sa préparation et sa récupération doivent aussi rester libres."

msgid "Duration, profile and price"
msgstr "Durée, profil et tarif"

msgid "Each open day needs a time range. Otherwise, mark it Closed."
msgstr "Chaque jour ouvert doit comporter une plage horaire. Sinon, cochez « Fermé »."

msgid "Each reservation belongs to a profile. Create one per professional or resource, then set its hours and date exceptions."
msgstr "Chaque réservation est rattachée à un profil. Créez-en un par professionnel ou ressource, puis définissez ses horaires et ses exceptions par date."

msgid "Each time range needs a start and an end."
msgstr "Chaque plage horaire doit avoir un début et une fin."

msgid "Edit booking profile"
msgstr "Modifier le profil de réservation"

msgid "Edit calendar event"
msgstr "Modifier l’événement"

msgid "Edit profile availability"
msgstr "Modifier les disponibilités du profil"

msgid "Edit service"
msgstr "Modifier la prestation"

msgid "Email"
msgstr "Adresse e-mail"

msgid "Email address"
msgstr "Adresse e-mail"

msgid "Enable availability for this profile"
msgstr "Activer les disponibilités de ce profil"

msgid "Enable booking for this service"
msgstr "Activer la réservation de cette prestation"

msgid "End"
msgstr "Fin"

msgid "End (UTC)"
msgstr "Fin (UTC)"

msgid "Enter a valid HTTPS address for your calendar service."
msgstr "Saisissez une adresse HTTPS valide pour votre agenda."

msgid "Enter a valid appointment duration and preparation/recovery times."
msgstr "Indiquez une durée de rendez-vous et des temps de préparation et de récupération valides."

msgid "Enter a valid booking date range."
msgstr "Indiquez une période de réservation valide."

msgid "Enter a valid client ID and secret. No credentials were changed."
msgstr "Saisissez un identifiant client et un secret valides. Aucun identifiant n’a été modifié."

msgid "Enter hours for the date exception or select Closed all day."
msgstr "Indiquez les horaires de cette date ou cochez « Fermé toute la journée »."

msgid "Enter the web address of your Nextcloud, then your login details."
msgstr "Saisissez l’adresse de votre Nextcloud, puis vos identifiants."

msgid "Enter valid, increasing times. Split overnight hours between two days."
msgstr "Indiquez des horaires valides, avec une fin après le début. Séparez sur deux jours les plages qui passent minuit."

msgid "Enter your calendar account and application password."
msgstr "Saisissez votre identifiant et votre mot de passe d’application."

msgid "Enter your calendar service address and account details."
msgstr "Saisissez l’adresse de votre service d’agenda, puis vos identifiants."

msgid "Enter your cloud address and choose an agenda."
msgstr "Saisissez l’adresse de votre cloud et choisissez un agenda."

msgid "Enter your name, a valid email and an available time, then accept the privacy information."
msgstr "Indiquez votre nom, une adresse e-mail valide et un horaire disponible, puis acceptez les informations de confidentialité."

msgid "Event"
msgstr "Événement"

msgid "Every new native reservation must belong to a profile. Add at least one professional or resource before creating bookable services."
msgstr "Chaque nouvelle réservation native doit être liée à un profil. Ajoutez au moins un professionnel ou une ressource avant de créer des prestations réservables."

msgid "Export to calendar"
msgstr "Export vers l’agenda"

msgid "Find Subscribe by URL, Internet calendar, or iCalendar subscription in your calendar application. Paste the link rather than importing a one-time ICS file."
msgstr "Recherchez S’abonner par URL, Agenda Internet ou Abonnement iCalendar dans votre application. Collez le lien au lieu d’importer une seule fois un fichier ICS."

msgid "Find events"
msgstr "Rechercher des événements"

msgid "Find my calendars"
msgstr "Trouver mes calendriers"

msgid "Finish by connecting your calendar account or creating an optional private calendar subscription."
msgstr "Terminez en connectant votre compte d’agenda ou en créant un abonnement privé facultatif."

msgid "Finish connecting an agenda below. Google and Outlook use account authorization; Nextcloud and iCloud use CalDAV."
msgstr "Terminez la connexion ci-dessous. Google et Outlook utilisent une autorisation de compte ; Nextcloud et iCloud utilisent CalDAV."

msgid "Finish connecting my calendar"
msgstr "Terminer la connexion de mon agenda"

msgid "Finish the Dendrila Calendar setup to enable your chosen appointment sources and destination."
msgstr "Terminez la configuration de Dendrila Calendar pour activer les sources et la destination souhaitées."

msgid "First bookable date"
msgstr "Première date réservable"

msgid "For a closed date, leave Closed all day checked. To remove an exception, clear its date and times."
msgstr "Pour fermer une date, laissez « Fermé toute la journée » coché. Pour supprimer une exception, effacez sa date et ses horaires."

msgid "For all-day events, use midnight for both times. The end date is the first day after the event."
msgstr "Pour une journée entière, indiquez minuit aux deux horaires. La date de fin correspond au premier jour après l’événement."

msgid "For paid appointments, select a published, purchasable simple virtual WooCommerce product. Its current price and taxes apply. A nonzero price without a valid product keeps online booking closed."
msgstr "Pour un rendez-vous payant, choisissez un produit WooCommerce simple, virtuel, publié et disponible à l’achat. Son prix actuel et ses taxes s’appliquent. Un tarif supérieur à zéro sans produit valide empêche la réservation en ligne."

msgid "Forbidden"
msgstr "Accès refusé"

msgid "Free"
msgstr "Gratuit"

msgid "Friday"
msgstr "Vendredi"

msgid "Give each date exception a valid, unique date."
msgstr "Indiquez une date valide et différente pour chaque exception."

msgid "Google / Outlook"
msgstr "Google / Outlook"

msgid "Google Calendar"
msgstr "Google Agenda"

msgid "Google Calendar and Outlook need OAuth account authorization and are not connected by this CalDAV form. Existing URL subscriptions remain available separately."
msgstr "Google Agenda et Outlook nécessitent une connexion OAuth, indisponible avec ce formulaire CalDAV. Les abonnements par URL restent disponibles séparément."

msgid "Google and Outlook can authorize access when the Dendrila OAuth application is enabled by the publisher. Otherwise a read-only calendar subscription remains available."
msgstr "Google et Outlook peuvent autoriser l’accès lorsque l’application OAuth Dendrila est activée par son éditeur. Sinon, un abonnement en lecture seule reste disponible."

msgid "Group"
msgstr "Regrouper"

msgid "HTTPS is required for private calendar subscriptions."
msgstr "Le protocole HTTPS est obligatoire pour les abonnements privés."

msgid "I agree that my name and email address may be used to manage this booking."
msgstr "J’accepte que mon nom et mon adresse e-mail soient utilisés pour gérer cette réservation."

msgid "If a provider cannot be checked, the new reservation is refused rather than double-booked."
msgstr "Si un agenda ne peut pas être vérifié, la réservation est refusée pour éviter un doublon."

msgid "If an active booking plugin is detected but its connector is unusable, saving sends a technical compatibility request for review. This includes only the plugin name, entrypoint, version, reason, WordPress/PHP versions and site URL — never appointments, customer data or passwords. Duplicate requests are suppressed."
msgstr "Si une extension de réservation active est détectée mais que son connecteur est inutilisable, l’enregistrement transmettra une demande technique de compatibilité. Elle contiendra uniquement le nom de l’extension, son fichier principal, sa version, le motif, les versions WordPress/PHP et l’URL du site — jamais les rendez-vous, données clients ou mots de passe. Les demandes identiques sont regroupées."

msgid "If you already paid, contact the site about its refund policy."
msgstr "Si vous avez déjà payé, contactez le site pour connaître ses conditions de remboursement."

msgid "If you select another previously connected calendar, its saved synchronization direction will be kept. You can change it after connecting."
msgstr "Si vous choisissez un autre agenda déjà connecté auparavant, son mode de synchronisation sera conservé. Vous pourrez le modifier après la connexion."

msgid "In Nextcloud Calendar, choose New calendar > New subscription from link and paste the private URL. It will appear as a read-only subscribed calendar."
msgstr "Dans l’application Agenda de Nextcloud, choisissez Nouvel agenda > Nouvel abonnement depuis un lien, puis collez l’URL privée. Cet agenda sera accessible en lecture seule."

msgid "In Outlook on the web, open Calendar > Add calendar > Subscribe from web. Paste the link and save. Updates can take more than 24 hours."
msgstr "Dans Outlook sur le web : Calendrier > Ajouter un calendrier > S’abonner à partir du web. Collez le lien et enregistrez. Les mises à jour peuvent demander plus de 24 heures."

msgid "Invalid availability settings."
